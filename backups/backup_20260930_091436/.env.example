# Modelo de variaveis de ambiente — copie para .env e preencha com valores reais.
# NUNCA commite o .env real (ja esta no .gitignore). Se vazar, rotacione imediatamente
# as chaves (SECRET_KEY e FERNET/FIELD_ENCRYPTION_KEY) e limpe o historico do Git.

# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET_KEY=
FIELD_ENCRYPTION_KEY=

# Hardening
DEBUG=False
# Lista separada por virgula. NUNCA use '*' em producao
ALLOWED_HOSTS=127.0.0.1,localhost
SECURE_SSL_REDIRECT=True

# Email SMTP real (necessario para reset de senha funcionar em producao)
EMAIL_HOST=smtp.seu-provedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@minhacarteira.com
