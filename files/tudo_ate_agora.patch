+{% if user.is_authenticated %}
+<script>
+$(document).ready(function () {
+  const modalEl = document.getElementById('modalRegistroRapido');
+  const form = document.getElementById('formRegistroRapido');
+  if (!modalEl || !form) return;
+
+  const erroBox = document.getElementById('quickAddErro');
+  const submitBtn = document.getElementById('quickAddSubmit');
+
+  // Ao abrir o modal: foco direto no valor (é o dado que a pessoa mais digita)
+  // e restaura a última categoria/tipo usados, pra não ter que escolher de novo toda vez.
+  modalEl.addEventListener('shown.bs.modal', function () {
+    document.getElementById('quickValor').focus();
+    erroBox.classList.add('d-none');
+
+    const ultimaCategoria = localStorage.getItem('quickAdd:ultimaCategoria');
+    if (ultimaCategoria) {
+      const sel = document.getElementById('quickCategoria');
+      if ([...sel.options].some(o => o.value === ultimaCategoria)) sel.value = ultimaCategoria;
+    }
+    const ultimoTipo = localStorage.getItem('quickAdd:ultimoTipo');
+    if (ultimoTipo) {
+      const radio = document.getElementById('quickTipo' + ultimoTipo);
+      if (radio) radio.checked = true;
+    }
+  });
+
+  // Atalho de teclado: tecla "n" abre o registro rápido de qualquer lugar da tela
+  // (sem estar dentro de um campo de texto, pra não atrapalhar quem está digitando).
+  document.addEventListener('keydown', function (e) {
+    const tag = (e.target.tagName || '').toLowerCase();
+    if (e.key === 'n' && tag !== 'input' && tag !== 'textarea' && tag !== 'select') {
+      e.preventDefault();
+      bootstrap.Modal.getOrCreateInstance(modalEl).show();
+    }
+  });
+
+  form.addEventListener('submit', function (e) {
+    e.preventDefault();
+    erroBox.classList.add('d-none');
+    submitBtn.disabled = true;
+    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Registrando...';
+
+    const formData = new FormData(form);
+    // O grupo de radio se chama "quickTipo" na tela pra ficar claro, mas o backend espera "tipo"
+    formData.set('tipo', formData.get('quickTipo'));
+
+    fetch("{% url 'cal:transacao_rapida' %}", {
+      method: 'POST',
+      headers: { 'X-Requested-With': 'XMLHttpRequest' },
+      body: formData,
+    })
+      .then(async (res) => {
+        const data = await res.json();
+        if (!res.ok || data.status !== 'success') {
+          throw new Error((data.errors && data.errors.join(' ')) || 'Não foi possível registrar. Tente novamente.');
+        }
+        return data;
+      })
+      .then((data) => {
+        // Lembra a escolha pra próxima vez
+        const categoriaSelecionada = document.getElementById('quickCategoria').value;
+        if (categoriaSelecionada) localStorage.setItem('quickAdd:ultimaCategoria', categoriaSelecionada);
+        localStorage.setItem('quickAdd:ultimoTipo', formData.get('quickTipo'));
+
+        bootstrap.Modal.getOrCreateInstance(modalEl).hide();
+        form.reset();
+        const opcoesAvancadas = document.getElementById('quickOpcoesAvancadas');
+        bootstrap.Collapse.getOrCreateInstance(opcoesAvancadas, { toggle: false }).hide();
+
+        // Se a página tiver uma lista de transações do mês, recarrega pra já mostrar o novo lançamento.
+        // Caso contrário, só confirma com uma mensagem simples.
+        if (document.querySelector('[data-transacoes-lista]') || window.location.pathname.includes('transacoes')) {
+          window.location.reload();
+        } else {
+          const toastMsg = document.createElement('div');
+          toastMsg.className = 'alert alert-success position-fixed shadow';
+          toastMsg.style.cssText = 'top:20px; left:50%; transform:translateX(-50%); z-index:2000;';
+          toastMsg.textContent = data.message;
+          document.body.appendChild(toastMsg);
+          setTimeout(() => toastMsg.remove(), 3000);
+        }
+      })
+      .catch((err) => {
+        erroBox.textContent = err.message;
+        erroBox.classList.remove('d-none');
+      })
+      .finally(() => {
+        submitBtn.disabled = false;
+        submitBtn.innerHTML = '<i class="bi bi-check-lg"></i> Registrar';
+      });
+  });
+});
+</script>
+{% endif %}
+
 </body>
 </html>
