+        <div class="col-md-6 mx-auto">
+            <div class="card border-0 shadow-sm p-4">
+                <h2 class="fw-bold text-primary mb-1"><i class="bi bi-arrow-repeat"></i> {{ titulo_pagina }}</h2>
+                <p class="text-muted small mb-4">Um lançamento gerado automaticamente todo mês — ideal para assinaturas, aluguel, mensalidades.</p>
+
+                <form method="post">
+                    {% csrf_token %}
+                    {% for field in form %}
+                    <div class="mb-3">
+                        <label class="form-label fw-bold">{{ field.label }}</label>
+                        {{ field }}
+                        {% if field.help_text %}
+                        <small class="text-muted d-block mt-1">{{ field.help_text }}</small>
+                        {% endif %}
+                        {% for error in field.errors %}
+                        <div class="text-danger small">{{ error }}</div>
+                        {% endfor %}
+                    </div>
+                    {% endfor %}
+
+                    <div class="d-grid gap-2">
+                        <button type="submit" class="btn btn-success">Salvar Recorrência</button>
+                        <a href="{% url 'cal:recorrencia_listar' %}" class="btn btn-outline-secondary">Cancelar</a>
+                    </div>
+                </form>
+            </div>
+        </div>
+    </div>
+</div>
+{% endblock %}
diff --git a/templates/cal/recorrencia_list.html b/templates/cal/recorrencia_list.html
new file mode 100644
