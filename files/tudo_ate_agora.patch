diff --git a/static/js/charts-theme.js b/static/js/charts-theme.js
new file mode 100644
index 0000000..2d03f6f
--- /dev/null
+++ b/static/js/charts-theme.js
@@ -0,0 +1,38 @@
+/**
+ * Paleta de gráficos da marca — usada por todo template que renderiza
+ * Chart.js. Antes, cada página (dashboard, transações, metas, cartões,
+ * resumo) declarava seu próprio array de cores ad-hoc, então o mesmo tipo
+ * de gráfico tinha cores diferentes dependendo da tela. Centralizar aqui
+ * garante consistência visual em todo o app.
+ */
+const BRAND_CHART = {
+  income: '#1F8A5F',
+  expense: '#B23A48',
+  neutral: '#DDE5E2',
+  gold: '#B8872E',
+
+  // Paleta categórica (categorias de gasto, metas, etc.) — tons derivados
+  // da marca (verde-petróleo, dourado, terracota) em vez do arco-íris
+  // padrão do Chart.js.
+  categorical: [
+    '#0F5E56', // verde-petróleo (marca)
+    '#B8872E', // dourado
+    '#4A7B73', // verde-petróleo claro
+    '#C1666B', // terracota
+    '#6E8B87', // verde acinzentado
+    '#D9A441', // âmbar
+    '#3D6D63', // verde escuro
+    '#A85751', // marrom-avermelhado
+  ],
+
+  corTipo(label) {
+    const l = (label || '').toLowerCase();
+    if (l.includes('entrada') || l.includes('crédito') || l.includes('credito')) return BRAND_CHART.income;
+    if (l.includes('saída') || l.includes('saida') || l.includes('débito') || l.includes('debito')) return BRAND_CHART.expense;
+    return BRAND_CHART.neutral;
+  },
+
+  coresPara(labels) {
+    return labels.map((_, i) => BRAND_CHART.categorical[i % BRAND_CHART.categorical.length]);
+  },
+};
