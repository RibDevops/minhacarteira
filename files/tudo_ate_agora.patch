diff --git a/static/css/brand.css b/static/css/brand.css
new file mode 100644
index 0000000..4e96fb8
--- /dev/null
+++ b/static/css/brand.css
@@ -0,0 +1,136 @@
+/* ==========================================================================
+   MINHA CARTEIRA — SISTEMA DE DESIGN
+   ==========================================================================
+   Fonte única de verdade para cor e tipografia da marca. Em vez de recompilar
+   o Bootstrap (que exigiria um pipeline Sass), sobrescrevemos as CSS
+   variables que o Bootstrap 5.3 expõe (--bs-primary, --bs-success, etc.) —
+   isso re-tematiza botões, badges, alerts, links e estados de foco em todo
+   o app a partir de UM lugar só, em vez de cada template escolher sua
+   própria cor.
+   ========================================================================== */
+
+:root {
+  /* ---- Paleta de marca ---- */
+  --brand-primary: #0F5E56;        /* Verde-petróleo profundo — confiança, estabilidade */
+  --brand-primary-rgb: 15, 94, 86;
+  --brand-primary-dark: #0A4640;
+  --brand-primary-light: #E4F0EE;
+
+  --brand-gold: #B8872E;           /* Dourado — moeda, destaque premium (uso pontual) */
+  --brand-gold-rgb: 184, 135, 46;
+
+  --brand-income: #1F8A5F;         /* Entradas */
+  --brand-income-rgb: 31, 138, 95;
+  --brand-expense: #B23A48;        /* Saídas — vermelho terroso, menos "erro de sistema" */
+  --brand-expense-rgb: 178, 58, 72;
+
+  --brand-ink: #17231F;            /* Texto principal — quase-preto esverdeado, não #000 puro */
+  --brand-ink-soft: #4A5A55;
+  --brand-paper: #F3F6F5;          /* Fundo — neutro frio, discreto */
+  --brand-surface: #FFFFFF;
+  --brand-border: #DDE5E2;
+
+  /* ---- Tipografia ---- */
+  --font-display: 'Fraunces', Georgia, 'Times New Roman', serif;
+  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+
+  /* ---- Ritmo visual ---- */
+  --radius-card: 14px;
+  --shadow-soft: 0 2px 10px rgba(23, 35, 31, 0.06);
+  --shadow-medium: 0 8px 24px rgba(23, 35, 31, 0.10);
+}
+
+/* --------------------------------------------------------------------------
+   Ponte com o Bootstrap: sobrescreve as variáveis de tema do BS 5.3.
+   Isso alcança .btn-primary, .text-primary, .bg-primary, .border-primary,
+   badges, alerts, focus ring de formulário — sem tocar em nenhum desses
+   componentes um por um.
+   -------------------------------------------------------------------------- */
+:root,
+[data-bs-theme="light"] {
+  --bs-primary: var(--brand-primary);
+  --bs-primary-rgb: var(--brand-primary-rgb);
+  --bs-primary-text-emphasis: var(--brand-primary-dark);
+  --bs-primary-bg-subtle: var(--brand-primary-light);
+  --bs-primary-border-subtle: #BFDAD5;
+  --bs-link-color: var(--brand-primary);
+  --bs-link-color-rgb: var(--brand-primary-rgb);
+  --bs-link-hover-color: var(--brand-primary-dark);
+
+  --bs-success: var(--brand-income);
+  --bs-success-rgb: var(--brand-income-rgb);
+  --bs-danger: var(--brand-expense);
+  --bs-danger-rgb: var(--brand-expense-rgb);
+  --bs-warning: var(--brand-gold);
+  --bs-warning-rgb: var(--brand-gold-rgb);
+
+  --bs-body-font-family: var(--font-body);
+  --bs-body-color: var(--brand-ink);
+  --bs-body-bg: var(--brand-paper);
+}
+
+body {
+  background-color: var(--brand-paper);
+  color: var(--brand-ink);
+}
+
+/* ---- Tipografia de destaque: reservada para títulos e valores em R$,
+   não para o corpo do texto (mantém tabelas e formulários 100% legíveis) ---- */
+h1, h2, .money-display {
+  font-family: var(--font-display);
+  font-weight: 600;
+  letter-spacing: -0.01em;
+}
+
+.money-display {
+  font-variant-numeric: tabular-nums;
+  font-feature-settings: "tnum";
+}
+
+/* ---- Cards: sombra e cantos consistentes em todo o app ---- */
+.card {
+  border-radius: var(--radius-card);
+}
+.card.shadow-sm {
+  box-shadow: var(--shadow-soft) !important;
+}
+
+/* ---- Botões: leve elevação e transição consistente ---- */
+.btn {
+  border-radius: 10px;
+  font-weight: 500;
+  transition: transform 0.15s ease, box-shadow 0.15s ease;
+}
+.btn-primary, .btn-success, .btn-danger {
+  box-shadow: 0 2px 6px rgba(23, 35, 31, 0.12);
+}
+.btn-primary:hover, .btn-success:hover, .btn-danger:hover {
+  transform: translateY(-1px);
+}
+
+/* ---- Badges de valor: usar as cores de marca, não o vermelho/verde puro do Bootstrap ---- */
+.text-success { color: var(--brand-income) !important; }
+.text-danger  { color: var(--brand-expense) !important; }
+.bg-success   { background-color: var(--brand-income) !important; }
+.bg-danger    { background-color: var(--brand-expense) !important; }
+
+/* ---- Acento dourado: reservado para elementos "premium" (destaques pontuais) ---- */
+.brand-accent { color: var(--brand-gold) !important; }
+.border-accent { border-color: var(--brand-gold) !important; }
+
+/* ---- Navbar: identidade de marca em vez de bg-dark genérico do Bootstrap ---- */
+.navbar-brand-bg {
+  background-color: var(--brand-primary-dark);
+}
+.navbar-brand .brand-wordmark {
+  font-family: var(--font-display);
+  font-weight: 600;
+  font-size: 1.15rem;
+  letter-spacing: -0.01em;
+}
+.navbar-brand-bg .nav-link {
+  transition: color 0.15s ease;
+}
+.navbar-brand-bg .nav-link:hover {
+  color: var(--brand-gold) !important;
+}
