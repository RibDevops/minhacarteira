+/* O <form> fica entre .modal-content e o header/body/footer, o que quebra
+   a cadeia flex que o Bootstrap usa para calcular a altura do scroll.
+   Sem isso, o .modal-body nunca recebe uma altura limitada e o conteudo
+   e cortado (overflow: hidden do .modal-content) em vez de rolar. */
