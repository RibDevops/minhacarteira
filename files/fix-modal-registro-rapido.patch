+    display: flex;
+    flex-direction: column;
+    min-height: 0;
+    overflow: hidden;
+}
+#modalRegistroRapido .modal-dialog-scrollable .modal-content > form .modal-body {
+    flex: 1 1 auto;
+    min-height: 0;
+}
